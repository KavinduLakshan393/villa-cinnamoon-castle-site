{
  "name": "villa-cinnamoon-castle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Photography-led flagship accommodation website for Villa Cinnamoon Castle.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4173",
    "build": "next build",
    "build:verify": "node scripts/build-verification.mjs",
    "start": "next start --hostname 127.0.0.1 --port 4173",
    "lint": "node scripts/lint-source.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --test --test-reporter=spec tests/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.0"
    }
  }
}
